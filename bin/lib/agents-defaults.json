{
  "version": 1,
  "profiles": {
    "glm":           { "harness": "zcode", "auth": "native", "shares": "zai-coding-plan", "maxParallel": 2 },
    "luna":          { "harness": "codex", "auth": "login", "model": "gpt-6-luna",  "effort": "max" },
    "sol":           { "harness": "codex", "auth": "login", "model": "gpt-6.1-sol", "effort": "xhigh" },
    "astra":         { "harness": "codex", "auth": "login", "model": "gpt-6-astra", "effort": "xhigh" },
    "astra-high":    { "harness": "codex", "auth": "login", "model": "gpt-6-astra", "effort": "high" },
    "opus-xhigh":    { "harness": "inproc", "model": "opus",   "effort": "xhigh" },
    "opus-high":     { "harness": "inproc", "model": "opus",   "effort": "high" },
    "sonnet-medium": { "harness": "inproc", "model": "sonnet", "effort": "medium" }
  },
  "roles": {
    "plan-writer":            ["opus-xhigh"],
    "plan-reviser":           ["opus-high"],
    "plan-reviewer":          ["astra"],
    "spec-reviewer":          ["astra"],
    "implementer":            ["glm", "luna"],
    "implementer.risk":       ["sol"],
    "implementer.escalation": ["sol"],
    "frontend.new-ui":        ["opus-high"],
    "frontend.tweak":         ["sonnet-medium"],
    "gate":                   ["sonnet-medium"],
    "phase-review":           ["opus-high"],
    "phase-review.escalated": ["opus-xhigh"],
    "control-review":         ["astra-high"],
    "synthesis":              ["sonnet-medium"],
    "final-review":           ["opus-xhigh", "astra"],
    "diagnosis":              ["opus-high"],
    "quickfix":               ["sonnet-medium"],
    "integration-check":      ["sonnet-medium"],
    "adhoc-review":           ["astra-high"]
  },
  "roleRuns": {
    "plan-writer":            "session",
    "plan-reviser":           "session",
    "plan-reviewer":          "external",
    "spec-reviewer":          "external",
    "implementer":            "external",
    "implementer.risk":       "external",
    "implementer.escalation": "external",
    "frontend.new-ui":        "session",
    "frontend.tweak":         "session",
    "gate":                   "session",
    "phase-review":           "session",
    "phase-review.escalated": "session",
    "control-review":         "external",
    "synthesis":              "session",
    "final-review":           "session-then-external",
    "diagnosis":              "session",
    "quickfix":               "session",
    "integration-check":      "session",
    "adhoc-review":           "external"
  },
  "reviewerRoles": [
    "plan-reviewer", "spec-reviewer", "phase-review", "phase-review.escalated", "control-review", "final-review", "adhoc-review"
  ],
  "presets": {
    "claude-sub": {
      "harness": "claude", "auth": "login", "model": "opus", "effort": "xhigh"
    },
    "claude-zai": {
      "harness": "claude", "auth": { "key": "zai" }, "shares": "zai-coding-plan",
      "endpoint": "https://api.z.ai/api/anthropic", "model": "glm-5.3[1m]",
      "env": { "API_TIMEOUT_MS": "3000000", "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000" }
    },
    "claude-deepseek": {
      "harness": "claude", "auth": { "key": "deepseek" },
      "endpoint": "https://api.deepseek.com/anthropic", "model": "deepseek-v4-pro[1m]",
      "env": { "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "786432" }
    },
    "claude-kimi": {
      "harness": "claude", "auth": { "key": "kimi" },
      "endpoint": "https://api.moonshot.ai/anthropic", "model": "kimi-k3[1m]"
    },
    "claude-minimax": {
      "harness": "claude", "auth": { "key": "minimax" },
      "endpoint": "https://api.minimax.io/anthropic", "model": "MiniMax-M3.1-Flash[1m]",
      "env": { "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "524288" }
    },
    "claude-alibaba": {
      "harness": "claude", "auth": { "key": "alibaba" },
      "endpoint": "https://<WorkspaceId>.<region>.maas.aliyuncs.com/apps/anthropic", "model": "<model>"
    },
    "claude-openrouter": {
      "harness": "claude", "auth": { "key": "openrouter" }, "authHeader": "bearer",
      "endpoint": "https://openrouter.ai/api", "model": "<model>",
      "env": { "ANTHROPIC_API_KEY": "" }
    },
    "claude-local": {
      "harness": "claude", "auth": "none",
      "endpoint": "http://127.0.0.1:<port>", "model": "<model>",
      "env": {
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "131072",
        "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "1800000",
        "API_FORCE_IDLE_TIMEOUT": "0",
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
      },
      "maxParallel": 1
    },
    "dsh-deepseek": {
      "harness": "dsh", "auth": { "key": "deepseek" }, "model": "deepseek-v4-pro", "effort": "high"
    },
    "opencode-login": {
      "harness": "opencode", "auth": "login", "model": "<provider/model>"
    },
    "opencode-key": {
      "harness": "opencode", "auth": { "key": "<name>" }, "keyVar": "<VAR>", "model": "<provider/model>"
    },
    "pi-key": {
      "harness": "pi", "auth": { "key": "<name>" }, "keyVar": "<VAR>", "model": "<provider/id>"
    }
  }
}
